{
  "name": "@geoql/maplibre-gl-starfield",
  "version": "0.1.3",
  "private": false,
  "description": "A MapLibre GL JS custom layer for rendering a Three.js starfield skybox with galaxy panorama",
  "keywords": [
    "galaxy",
    "globe",
    "layer",
    "maplibre",
    "skybox",
    "starfield",
    "stars",
    "three",
    "threejs"
  ],
  "homepage": "https://maplibre-gl-starfield.geoql.in",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-starfield/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-starfield.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "echo 'test!'",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish",
    "dev:demo": "pnpm --filter ./example dev",
    "build:demo": "pnpm run build && pnpm --filter ./example build",
    "deploy:demo": "pnpm run build:demo && pnpm --filter ./example deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.15.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "maplibre-gl": ">=3.0.0",
    "three": ">=0.135.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
